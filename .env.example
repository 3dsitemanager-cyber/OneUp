# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers → copy the connection string.
# Replace <user>, <password> and the cluster host. The database name goes after
# the host ("/oneupgames" below) — Atlas does NOT create it until first write.
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/oneupgames?retryWrites=true&w=majority&appName=Cluster0"

# ── Admin auth ───────────────────────────────────────────────────────────────
# Session signing secret. Generate one with:  openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seeded admin account (`npm run seed` creates it if missing)
ADMIN_EMAIL="admin"
ADMIN_PASSWORD="ChangeThisPassword123!"

# ── Cloudinary (file + image storage) ────────────────────────────────────────
# Cloudinary Console → Settings → API Keys.
# Deliberately NOT prefixed with NEXT_PUBLIC_ — the secret signs uploads on the
# server and must never be shipped to the browser.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="your-api-secret"

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
